{
  "name": "three-things",
  "productName": "Three Things",
  "version": "0.10.1",
  "private": true,
  "description": "A small desktop home for today, this week, and this month.",
  "main": "src/desktop-main.cjs",
  "author": "Bud Hennekes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui-pass.cjs && node test/continuation.cjs && node test/clear-today.cjs && node test/clear-period.cjs && node test/day-navigation.cjs",
    "package:mac": "electron-builder --mac zip",
    "test:fullscreen": "node test/fullscreen.cjs",
    "build:mobile": "node mobile/build.cjs",
    "test:mobile": "node test/mobile.cjs",
    "test:mobile-motion": "node test/mobile-motion.cjs"
  },
  "build": {
    "appId": "com.budhennekes.threethings",
    "productName": "Three Things",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "minimumSystemVersion": "13.0"
    },
    "artifactName": "ThreeThings-${version}-mac-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "playwright": "1.58.2"
  }
}
